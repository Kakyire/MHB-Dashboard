# Firebase web-app configuration values are public identifiers, not service credentials.
# Copy this file to .env.local and complete it from Firebase Console > Project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=mhb-staging
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Register this web app with Firebase App Check using reCAPTCHA Enterprise.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
